# .env.example — configuration for the pgvector + embedding + Cohere-rerank service.
# Secrets are read from Key Vault (vinny-kb-tool-vault1) when AZURE_KEY_VAULT_URL is
# reachable via managed identity; the env vars below override for local runs / CI.

# ── Secrets (env overrides Key Vault) ───────────────────────────────────────
# PG_CONN=postgresql://kbadmin:<password>@teva-kb-vectordb.postgres.database.azure.com:5432/kbtool?sslmode=require
# TEVA_AI_KEY=<Teva AI Services key>            # shared by embeddings + Cohere rerank
AZURE_KEY_VAULT_URL=https://vinny-kb-tool-vault1.vault.azure.net

# ── Embeddings (Azure OpenAI, text-embedding-3-small) ──────────────────────
EMBED_ENDPOINT=https://teva.openai.azure.com
EMBED_DEPLOYMENT=text-embedding-3-small
EMBED_API_VERSION=2023-05-15
EMBED_DIMS=1536

# ── Cohere rerank (Azure AI Foundry) ────────────────────────────────────────
# OPEN ITEM: the exact REST route for Cohere-rerank-v4 on the Foundry endpoint
# is not yet pinned down (all standard /v2/rerank paths returned 404). Get the
# "Target URI" from the deployment page in Azure AI Foundry and set RERANK_PATH
# (+ RERANK_API_VERSION / RERANK_AUTH_STYLE) accordingly. Until then the service
# runs in cosine-fallback mode (already top-1 95.9% / recall@3 100% on the gold set).
RERANK_ENABLED=true
RERANK_ENDPOINT=https://teva.services.ai.azure.com
RERANK_DEPLOYMENT=cohere-rerank-v4-fast
RERANK_PATH=/v2/rerank
RERANK_API_VERSION=
RERANK_AUTH_STYLE=bearer          # 'bearer' | 'api-key'

# ── Retrieval knobs ─────────────────────────────────────────────────────────
VECTOR_K=30
KEYWORD_K=30
RRF_K=60
RETURN_K=3
RERANK_K=10

# ── Score bands (0..1) — validated for cosine mode; recalibrate if rerank on ──
CONFIDENT_SCORE=0.60
MIN_DISPLAY_SCORE=0.40
FOLLOWUP_FLOOR=0.15
SPREAD_THRESHOLD=0.10

# ── Follow-up grounding (description vs heading/cause/question) ─────────────
TOP_FIELDS_K=3
MIN_FIELD_SCORE=0.40

# ── Round cap ────────────────────────────────────────────────────────────────
MAX_ROUNDS=5
SESSION_TTL_SECONDS=3600

# ── Optional API-key auth on the tool ───────────────────────────────────────
REQUIRE_API_KEY=false
# TOOL_API_KEY=<set to enforce x-api-key>
